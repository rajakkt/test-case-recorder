# Copy this to .env and fill in your values.
# Keep .env out of source control.

# Required to run the uploader
ZEPHYR_JSON_PATH=C:\path\to\zephyr-test-case.json
# Optional batch mode: if set, uploads all *.json files from this folder one by one.
ZEPHYR_JSON_FOLDER=
ZEPHYR_ENDPOINT=https://api.zephyrscale.smartbear.com/v2/testcases
ZEPHYR_AUTH_TYPE=bearer
ZEPHYR_TOKEN=replace-with-token

# Metadata defaults applied during upload
ZEPHYR_PROJECT_KEY=DEMO
ZEPHYR_NAME=Checkout flow works
ZEPHYR_OBJECTIVE=The order history should display successfully
ZEPHYR_PRECONDITION=Valid user credentials are available
ZEPHYR_PRIORITY=Normal
ZEPHYR_STATUS=Draft
ZEPHYR_FOLDER=Hisco/Updated Testscripts(Hisco)
ZEPHYR_SEGMENT=Order History
ZEPHYR_LABELS=Develop,Sandbox,Production

# Optional screenshot upload resilience settings (for transient CloudFront/503 issues)
ZEPHYR_STEP_SCREENSHOT_UPLOAD_RETRIES=3
ZEPHYR_STEP_SCREENSHOT_RETRY_DELAY_MS=1200